+            frame = await encode(codec)
+            pending = None
+            if frame is not None:
+                metadata = self.video.guide_by_pts.pop(frame.timestamp, None)
+                if metadata is not None:
+                    pending = (codec.payloadType, metadata, frame.timestamp)
+            return frame
