+@router.post("/{session_id}/webrtc/reset")
+async def reset_guide_receiver(session_id: str, body: dict, request: Request) -> dict:
+    segment_id = body.get("segment_id")
+    if not isinstance(segment_id, str) or not 1 <= len(segment_id) <= 128:
+        raise HTTPException(status_code=422, detail="segment_id required")
+    if not await session_service.get_session(request.app.state.redis, session_id):
+        raise HTTPException(status_code=404, detail="session not found")
+    # Persist the cancellation before ACK, including requests whose multipart body
+    # has not finished arriving. The worker also fences tasks already in its queue.
+    r = request.app.state.redis
+    bounded_hash = getattr(r, "hset_bounded", None)
+    if bounded_hash is not None:
+        accepted = await bounded_hash(f"guide:cancelled:{session_id}", segment_id, "1", 1024, 3600)
+    else:
+        accepted = await r.eval("""
+            if redis.call('HEXISTS', KEYS[1], ARGV[1]) == 0 and redis.call('HLEN', KEYS[1]) >= 1024 then return 0 end
+            redis.call('HSET', KEYS[1], ARGV[1], '1'); redis.call('EXPIRE', KEYS[1], 3600); return 1
+        """, 1, f"guide:cancelled:{session_id}", segment_id)
+    if not accepted:
+        raise HTTPException(status_code=409, detail="GUIDE_CANCEL_CAPACITY")
+    runners = getattr(request.app.state, "session_runners", None)
+    if runners is not None:
+        runner = runners.get(session_id)
+        if not runner or not hasattr(runner, "reset_guide_receiver"):
+            raise HTTPException(status_code=409, detail="receiver reset unavailable")
+        return await runner.reset_guide_receiver(segment_id)
+    import asyncio
+    try:
+        return await asyncio.wait_for(forward_worker_json(request.app.state.settings.worker_url,
+                                      f"webrtc/{session_id}/reset", {"segment_id": segment_id}), timeout=12)
+    except Exception as exc:
+        raise HTTPException(status_code=502, detail="receiver reset failed") from exc
