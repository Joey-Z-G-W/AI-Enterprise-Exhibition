+        async def send(data):
+            nonlocal last_rtp, timestamp_origin
+            # Ignore RTCP, RTX, other tracks and duplicate fragments of the same video frame.
+            if pending is not None and len(data) >= 12 and data[0] >> 6 == 2 and not 192 <= data[1] <= 223:
+                payload_type = data[1] & 127
+                ssrc = int.from_bytes(data[8:12], "big")
+                stamp = int.from_bytes(data[4:8], "big")
+                if ssrc == sender._ssrc and payload_type == pending[0] and timestamp_origin is None:
+                    timestamp_origin = (stamp - pending[2]) & 0xffffffff
+                expected = ((timestamp_origin or 0) + pending[2]) & 0xffffffff
+                if ssrc == sender._ssrc and payload_type == pending[0] and stamp == expected and stamp != last_rtp:
+                    last_rtp = stamp
+                    if channel is not None and channel.readyState == "open":
+                        segment_id, source_ms = pending[1]
+                        channel.send(json.dumps({"type": "frame", "version": 1,
+                            "generation": self.guide_generation, "rtp_timestamp": stamp,
+                            "segment_id": segment_id, "source_ms": source_ms}))
+            await transmit(data)
+        sender._next_encoded_frame = encoded
+        sender.transport._send_rtp = send
