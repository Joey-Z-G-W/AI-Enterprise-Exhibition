+@router.post("/preview-aligned")
+async def preview_aligned(body: TTSPreviewRequest) -> dict:
+    """One Edge synthesis yields both the decoded WAV and native sentence boundaries."""
+    import asyncio
+    import base64
+    import edge_tts
+    from opentalking.providers.tts.edge.adapter import _decode_mp3_to_pcm16_mono
+
+    text, voice, provider, _, _ = _normalize_preview_request(body)
+    if provider not in (None, "edge", "edge_tts"):
+        raise HTTPException(status_code=422, detail="aligned preview requires Edge TTS")
+    audio = bytearray()
+    timeline = []
+    async def collect():
+        async for event in edge_tts.Communicate(text, voice or "zh-CN-XiaoxiaoNeural", boundary="SentenceBoundary").stream():
+            if event["type"] == "audio":
+                audio.extend(event["data"])
+            elif event["type"] == "SentenceBoundary":
+                timeline.append({"text": event["text"], "start_ms": event["offset"] / 10000,
+                                 "end_ms": (event["offset"] + event["duration"]) / 10000})
+    try:
+        await asyncio.wait_for(collect(), timeout=60)
+        pcm, sr = await asyncio.to_thread(_decode_mp3_to_pcm16_mono, bytes(audio), 16000)
+    except Exception as exc:
+        raise HTTPException(status_code=502, detail="aligned speech synthesis failed") from exc
+    if not len(pcm):
+        raise HTTPException(status_code=502, detail="empty speech synthesis")
+    return {"audio_base64": base64.b64encode(_wav_bytes([pcm], sr)).decode("ascii"),
+            "timeline": timeline, "duration_ms": len(pcm) * 1000 / sr,
+            "timing_source": "edge-sentence-boundary", "sample_rate": sr}
