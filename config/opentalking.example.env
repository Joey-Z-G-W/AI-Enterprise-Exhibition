# Linux RTX4060 8GB profile. Copied to ignored config/opentalking.env.
OPENTALKING_DEFAULT_MODEL=quicktalk
OPENTALKING_QUICKTALK_BACKEND=local
OPENTALKING_INFERENCE_MOCK=0
OPENTALKING_TORCH_DEVICE=cuda:0
OPENTALKING_QUICKTALK_DEVICE=cuda:0
OPENTALKING_QUICKTALK_HUBERT_DEVICE=cpu
OPENTALKING_QUICKTALK_MAX_LONG_EDGE=512
OPENTALKING_QUICKTALK_RESOLUTION=256
OPENTALKING_QUICKTALK_MAX_TEMPLATE_SECONDS=5
OPENTALKING_QUICKTALK_WORKER_CACHE=1
OPENTALKING_QUICKTALK_WORKER_CACHE_MAX=1
OPENTALKING_PREWARM_AVATARS=
OPENTALKING_STT_DEFAULT_PROVIDER=sensevoice
OPENTALKING_STT_ENABLED_PROVIDERS=sensevoice
OPENTALKING_STT_SENSEVOICE_DEVICE=cpu
OPENTALKING_TTS_DEFAULT_PROVIDER=edge
OPENTALKING_TTS_ENABLED_PROVIDERS=edge
OPENTALKING_TTS_EDGE_VOICE=zh-CN-XiaoxiaoNeural
# Semantic chunk retrieval avoids an extra remote keyword-generation request.
OPENTALKING_AGENT_LIGHTRAG_QUERY_MODE=naive
OPENTALKING_KNOWLEDGE_CHUNK_VERSION=linux-bge-window-v1
MAX_GLEANING=0
# LLM / embedding credentials belong in this local file, never in git.
