{
  "name": "exhibition-guide-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5290 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:browser": "node ../tests/frontend/speech-browser-integration.cjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5290 --strictPort",
    "prepare-vad-assets": "node scripts/prepare-vad-assets.mjs",
    "predev": "npm run prepare-vad-assets",
    "prebuild": "npm run prepare-vad-assets"
  },
  "dependencies": {
    "@ricky0123/vad-web": "0.0.31",
    "onnxruntime-web": "1.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "playwright-core": "1.62.1",
    "typescript": "5.6.3",
    "vite": "5.4.21"
  }
}
